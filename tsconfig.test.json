{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": ".test-dist",
    "incremental": false,
    "isolatedModules": false,
    "allowJs": false,
    "plugins": []
  },
  "include": [
    "lib/arxiv.ts",
    "lib/arxiv-plan.ts",
    "lib/rate-limit.ts",
    "tests/*.test.ts"
  ],
  "exclude": ["node_modules"]
}
